{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ],
  "tasks": [
    {
      "label": "vite: dev",
      "type": "process",
      "command": "pnpm",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE|vite",
          "endsPattern": "ready in|Local:|network:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "panelId": "vite-dev",
        "showReuseMessage": false
      }
    },
    {
      "label": "kill: all",
      "type": "shell",
      "command": "echo ${input:terminate}",
      "problemMatcher": []
    },
    {
      "label": "tauri: build (debug)",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--manifest-path", "src-tauri/Cargo.toml"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    }
  ]
}
