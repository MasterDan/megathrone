# Megathrone — development-mode environment.
# Vite loads this file only for `pnpm dev` / `pnpm tauri dev` (mode=development);
# release builds (`pnpm build`, `tauri build`) are unaffected.
# Restart the dev server after changing anything here.

# UI variant baked into the build: desktop | mobile (see src/platform.ts).
# Desktop is the dev default; swap the comments to evaluate the mobile
# interface (the full layout switch — the ?ui= query param only tweaks
# runtime context bits).
VITE_UI_VARIANT=desktop
# VITE_UI_VARIANT=mobile
