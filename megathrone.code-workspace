{
  "folders": [
    {
      "path": ".",
      "name": "Megathrone — workspace root"
    },
    {
      "path": "packages/core",
      "name": "core — UI library (SolidJS)"
    },
    {
      "path": "packages/tauri",
      "name": "tauri — desktop/Android shell (frontend)"
    },
    {
      "path": "packages/web",
      "name": "web — browser shell (frontend)"
    },
    {
      "path": "src-tauri",
      "name": "tauri — Rust app + cargo workspace"
    },
    {
      "path": "src-tauri/crates/core",
      "name": "core — Rust backend library"
    },
    {
      "path": "src-tauri/crates/web",
      "name": "web — console web server (Rust)"
    }
  ],
  "extensions": {
    "recommendations": [
      "tauri-apps.tauri-vscode",
      "rust-lang.rust-analyzer",
      "vadimcn.vscode-lldb",
      "bradlc.vscode-tailwindcss"
    ]
  },
  "settings": {
    "editor.fontLigatures": true,
    "cSpell.words": [
      "axum",
      "clap",
      "daisyui",
      "serde",
      "solidjs",
      "tailwindcss",
      "tauri",
      "vite"
    ],
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/target/**": true,
      "**/binaries/**": true,
      "src-tauri/gen/**": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/target": true,
      "**/binaries": true,
      "src-tauri/gen": true,
      "pnpm-lock.yaml": true
    }
  }
}
